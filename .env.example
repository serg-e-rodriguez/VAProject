# NC Campaign Intelligence: copy to .env (git-ignored). All keys are optional for running the app.

# Gemini (War Room step 5: analysis, questions, "Let Gemini change the plan"). Google AI Studio key.
# GEMINI_KEY, GEMINI_API_KEY or GOOGLE_API_KEY are also accepted.
GEMINI_API="your_gemini_api_key_here"
# Optional: models to try in order (comma-separated).
# GEMINI_MODEL="gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash"

# Meta Ad Library API token: verifies Meta ad links before they are shown; needed to rebuild Meta data.
META_AD_TOKEN="your_meta_ad_library_token_here"

# Google Cloud project for BigQuery (only to rebuild the snapshot). Credentials come from
# `gcloud auth application-default login` or GOOGLE_APPLICATION_CREDENTIALS=path/to/key.json.
GCP_PROJECT_ID="your_gcp_project_id"

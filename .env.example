# Meta Ad Library API User Token (Requires a Meta User Token with the following permissions:
# ads_management, ads_read, business_management, pages_read_engagement, pages_manage_ads, leads_retrieval)
# SECURITY MANDATE: NEVER commit actual tokens to code or git repositories!
META_USER_TOKEN="your_meta_user_token_here"
# Backward-compatibility aliases:
# META_APP_TOKEN="your_meta_user_token_here"
# META_AD_TOKEN="your_meta_user_token_here"

# Google Cloud BigQuery Project ID
GCP_PROJECT_ID="virtualanalytics5122"

# Optional: Path to Google Application Credentials if using service account file
# GOOGLE_APPLICATION_CREDENTIALS="path/to/service_account.json"
